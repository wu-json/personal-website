{
  "plugins": ["react", "typescript", "jsx-a11y"],
  "jsPlugins": ["./lint/no-comments.js"],
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "settings": {
    "react": {
      "version": "18.0"
    }
  },
  "rules": {
    "jsx-a11y/prefer-tag-over-role": "off",
    "local/no-comments": "error"
  },
  "ignorePatterns": ["build/**/*", "node_modules/**/*"]
}
